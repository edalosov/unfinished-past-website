// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Singleton row (id always 1) holding the live gallery settings: which
// NFT contract to read ownership from, and which chain it lives on.
// Editable from /admin without a redeploy.
model GalleryConfig {
  id                Int      @id @default(1)
  nftContractAddress String?
  chainId           Int      @default(11155111) // Sepolia by default
  updatedAt         DateTime @updatedAt
}

// A scheduled "question of the year" — each has an explicit availability
// window (normally exactly one year). The admin can queue future
// questions ahead of time; whichever question's window contains the
// current moment is "the" active one, computed on read rather than
// toggled by hand. Windows are validated not to overlap, so there's
// never ambiguity about which question is current.
model Question {
  id        String   @id @default(cuid())
  text      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  answers   Answer[]

  @@index([startsAt, endsAt])
}

// A wallet-signed answer to a question, scoped to a specific owned token.
// Exactly one answer per (wallet, token, question) — once a holder
// answers a given year's question for a piece, that year is locked in;
// the panel shows it back read-only rather than allowing a resubmission.
model Answer {
  id            String   @id @default(cuid())
  walletAddress String // the token's actual owner (the vault, if delegated via delegate.xyz)
  signerAddress String? // set when a delegate.xyz-delegated hot wallet signed on the owner's behalf
  tokenId       String
  tokenName     String // snapshotted at submission time — keeps admin views fast and Alchemy-independent
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText    String
  signature     String
  createdAt     DateTime @default(now())

  @@unique([walletAddress, tokenId, questionId])
  @@index([walletAddress, tokenId])
  @@index([questionId])
}
